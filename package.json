{
  "name": "manekilex",
  "version": "0.11.1",
  "private": true,
  "description": "Manekilex Chrome extension (MV3, no build step). npm is only used for the Node test runner and the dictionary maintenance scripts; browser libraries are vendored in lib/ (see lib/README.md).",
  "scripts": {
    "test": "node --test",
    "test:browser": "node --test --test-concurrency=1 tests/browser/pdf-reader.browser.js tests/browser/reader.browser.js tests/browser/settings-providers.browser.js tests/browser/lookup-hosts.browser.js",
    "perf": "node tests/perf/baseline.perf.js",
    "build:dictionary": "node scripts/build-dictionary.js",
    "migrate:dictionary": "node scripts/migrate-dictionary-format.js",
    "enrich:dictionary": "node scripts/enrich-dictionary.js",
    "audit:dictionary": "node scripts/audit-dictionary.js",
    "clean:dictionary": "node scripts/clean-dictionary-entries.js",
    "check": "node scripts/check-repo.js",
    "check:syntax": "node scripts/check-repo.js syntax",
    "check:manifest": "node scripts/check-repo.js manifest",
    "check:dictionary": "node scripts/check-repo.js dictionary",
    "check:hygiene": "node scripts/check-repo.js hygiene"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "csv-parse": "^7.0.3"
  }
}
